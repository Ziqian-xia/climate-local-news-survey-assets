      "SecondaryAttribute": "climate_increased_hazards",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "The next questions are about climate change and weather events.<br><br>To what extent do you think that climate change has increased the frequency or impact of each hazard over the last decades?",
        "DataExportTag": "climate_increased_hazards",
