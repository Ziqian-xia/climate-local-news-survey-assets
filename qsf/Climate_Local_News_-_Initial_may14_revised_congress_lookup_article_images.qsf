        "QuestionID": "QID48",
        "QuestionJS": "Qualtrics.SurveyEngine.addOnReady(function() {\n  var order = Qualtrics.SurveyEngine.getEmbeddedData('hazardOrder');\n  var hazards = ['heatwaves','floods','hurricanes','wildfires','droughts','tornadoes','earthquakes'];\n  if (!order) {\n    for (var i = hazards.length - 1; i > 0; i--) {\n      var j = Math.floor(Math.random() * (i + 1));\n      var tmp = hazards[i]; hazards[i] = hazards[j]; hazards[j] = tmp;\n    }\n    order = hazards.join('|');\n    Qualtrics.SurveyEngine.setEmbeddedData('hazardOrder', order);\n  }\n  var wanted = order.split('|');\n  var container = this.getQuestionContainer();\n  if (container && container.jquery) container = container[0];\n  var rows = container.querySelectorAll ? Array.prototype.slice.call(container.querySelectorAll('tr, li')) : [];\n  rows.forEach(function(row) {\n    var label = row.textContent.toLowerCase();\n    var idx = wanted.findIndex(function(h) { return label.indexOf(h) !== -1; });\n    if (idx >= 0) row.setAttribute('data-hazard-order', idx);\n  });\n  rows.filter(function(r) { return r.hasAttribute('data-hazard-order'); })\n      .sort(function(a, b) { return +a.getAttribute('data-hazard-order') - +b.getAttribute('data-hazard-order'); })\n      .forEach(function(row) { row.parentNode.appendChild(row); });\n});"
