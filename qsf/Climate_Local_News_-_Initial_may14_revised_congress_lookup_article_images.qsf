        "NextAnswerId": 5,
        "QuestionID": "QID18",
        "QuestionJS": "Qualtrics.SurveyEngine.addOnReady(function() {\n  var q = this;\n  var container = q.getQuestionContainer();\n  if (container && container.jquery) container = container[0];\n  function selectedBeyondNever(row) {\n    var inputs = row.querySelectorAll('input[type=\"radio\"], input[type=\"checkbox\"]');\n    for (var i = 0; i < inputs.length; i++) {\n      if (inputs[i].checked) return i > 0;\n    }\n    return false;\n  }\n  Qualtrics.SurveyEngine.addOnPageSubmit(function() {\n    var cable = '0';\n    var other = '0';\n    if (container && container.querySelectorAll) {\n      var rows = container.querySelectorAll('tr, li');\n      Array.prototype.forEach.call(rows, function(row) {\n        var label = (row.textContent || row.innerText || '').toLowerCase();\n        if (label.indexOf('national cable news') >= 0 && selectedBeyondNever(row)) cable = '1';\n        if (/\\bother\\b/.test(label) && selectedBeyondNever(row)) other = '1';\n      });\n    }\n    Qualtrics.SurveyEngine.setEmbeddedData('cableNewsAny', cable);\n    Qualtrics.SurveyEngine.setEmbeddedData('newsSourceOtherAny', other);\n  });\n});\n\nQualtrics.SurveyEngine.addOnReady(function() {\n  var container = this.getQuestionContainer();\n  if (container && container.jquery) container = container[0];\n  if (!container || !container.querySelector) return;\n  var style = document.createElement('style');\n  style.textContent = [\n    '#' + container.id + ' table thead th { position: sticky; top: 0; z-index: 5; background: #fff; }',\n    '#' + container.id + ' table thead td { position: sticky; top: 0; z-index: 5; background: #fff; }'\n  ].join('\\n');\n  document.head.appendChild(style);\n  var table = container.querySelector('table');\n  var thead = table ? table.querySelector('thead') : null;\n  if (table && thead && !table.querySelector('tfoot')) {\n    var foot = document.createElement('tfoot');\n    foot.innerHTML = thead.innerHTML;\n    table.appendChild(foot);\n  }\n});"
      }
    },
