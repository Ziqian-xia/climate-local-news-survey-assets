      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "Please type the following sentence: <strong>I am able to commit to this</strong>",
        "DataExportTag": "commitment",
        "QuestionType": "TE",
        "Selector": "SL",
        "Configuration": {
