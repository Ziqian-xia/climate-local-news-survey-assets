        "Header": "\n<script>\nQualtrics.SurveyEngine.addOnload(function() {\n  var q = Qualtrics.SurveyEngine;\n  function getText(id) {\n    var el = document.getElementById(id);\n    return el ? (el.textContent || el.innerText || '').trim() : '';\n  }\n  function splitList(value) {\n    value = (value || '').trim();\n    if (!value || value === '${e://Field/worktimeArray}' || value === '${e://Field/perPagePT}') return [];\n    return value.split('||').filter(function(x) { return x !== ''; });\n  }\n  function sum(list) {\n    return list.reduce(function(total, value) {\n      var n = parseFloat(value);\n      return total + (isNaN(n) ? 0 : Math.abs(n));\n    }, 0);\n  }\n  function pageLabel() {\n    var node = document.querySelector('.QuestionText');\n    var txt = node ? (node.textContent || node.innerText || '').replace(/\\s+/g, ' ').trim() : '';\n    return txt.substring(0, 120);\n  }\n\n  var work = splitList(getText('timeArrayDIV'));\n  var onTask = splitList(getText('onTaskDIV'));\n  var offTask = splitList(getText('offTaskDIV'));\n  var perPage = splitList(getText('perPagePTArrayDIV'));\n  var pageNo = parseInt(getText('page-no-DIV'), 10);\n  if (isNaN(pageNo)) pageNo = 0;\n  var currentPageNo = pageNo + 1;\n  var currentPageLabel = pageLabel();\n  var pageStart = Date.now();\n  var segmentStart = pageStart;\n  var currentFocus = document.hasFocus ? document.hasFocus() : true;\n  var segments = [];\n\n  q.setEmbeddedData('currentPageNo', currentPageNo);\n  q.setEmbeddedData('currentPageLabel', currentPageLabel);\n  q.setEmbeddedData('currentPageStartedAt', new Date(pageStart).toISOString());\n  function heartbeat() {\n    q.setEmbeddedData('currentPageLastSeenAt', new Date().toISOString());\n    q.setEmbeddedData('currentPageElapsedSeconds', ((Date.now() - pageStart) / 1000).toFixed(3));\n  }\n  heartbeat();\n  var heartbeatTimer = setInterval(heartbeat, 5000);\n\n  function pushSegment(focused) {\n    var elapsed = (Date.now() - segmentStart) / 1000;\n    if (elapsed < 0.05) return;\n    var value = elapsed.toFixed(3);\n    if (focused) {\n      work.push(value);\n      onTask.push(value);\n      segments.push('on:' + value);\n    } else {\n      work.push('-' + value);\n      offTask.push(value);\n      segments.push('off:' + value);\n    }\n    segmentStart = Date.now();\n  }\n\n  window.addEventListener('blur', function() {\n    pushSegment(true);\n    currentFocus = false;\n  });\n  window.addEventListener('focus', function() {\n    pushSegment(false);\n    currentFocus = true;\n  });\n\n  q.addOnPageSubmit(function() {\n    clearInterval(heartbeatTimer);\n    heartbeat();\n    pushSegment(currentFocus);\n    var pageSeconds = ((Date.now() - pageStart) / 1000).toFixed(3);\n    perPage.push(currentPageNo + '::' + currentPageLabel + '::' + pageSeconds + '::' + segments.join(','));\n    q.setEmbeddedData('worktimeArray', work.join('||'));\n    q.setEmbeddedData('perPagePT', perPage.join('||'));\n    q.setEmbeddedData('onTask', onTask.join('||'));\n    q.setEmbeddedData('offTask', offTask.join('||'));\n    q.setEmbeddedData('tasktime', sum(work).toFixed(3));\n    q.setEmbeddedData('totalOnTask', sum(onTask).toFixed(3));\n    q.setEmbeddedData('totalOffTask', sum(offTask).toFixed(3));\n    q.setEmbeddedData('pageNo', currentPageNo);\n    q.setEmbeddedData('lastCompletedPageNo', currentPageNo);\n    q.setEmbeddedData('lastCompletedPageLabel', currentPageLabel);\n  });\n  window.addEventListener('beforeunload', heartbeat);\n});\n</script>\n",
        "Footer": "\n<div id=\"taskmaster-store\" style=\"display:none\">\n  <div id=\"page-no-DIV\">${e://Field/pageNo}</div>\n  <div id=\"timeArrayDIV\">${e://Field/worktimeArray}</div>\n  <div id=\"perPagePTArrayDIV\">${e://Field/perPagePT}</div>\n  <div id=\"onTaskDIV\">${e://Field/onTask}</div>\n  <div id=\"offTaskDIV\">${e://Field/offTask}</div>\n  <div id=\"onTaskTotalDIV\">${e://Field/totalOnTask}</div>\n  <div id=\"offTaskTotalDIV\">${e://Field/totalOffTask}</div>\n</div>\n",
        "ProgressBarDisplay": "None",
        "PartialData": "+1 week",
        "ValidationMessage": "",
        "PreviousButton": "Back",
        "NextButton": "Continue",
