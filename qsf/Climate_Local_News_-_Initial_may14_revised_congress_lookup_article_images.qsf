            "Type": "None"
          }
        },
        "Language": [],
        "NextChoiceId": 1,
        "NextAnswerId": 1,
        "QuestionID": "QID4",
        "QuestionJS": "Qualtrics.SurveyEngine.addOnReady(function() {\n  var container = this.getQuestionContainer();\n  if (container && container.jquery) container = container[0];\n  if (!container || !container.querySelectorAll) return;\n  var fields = container.querySelectorAll('textarea, input[type=\"text\"], input.InputText, .InputText');\n  Array.prototype.forEach.call(fields, function(field) {\n    ['copy', 'cut', 'paste', 'drop'].forEach(function(eventName) {\n      field.addEventListener(eventName, function(event) {\n        event.preventDefault();\n        return false;\n      });\n    });\n    field.setAttribute('autocomplete', 'off');\n    field.setAttribute('autocorrect', 'off');\n    field.setAttribute('autocapitalize', 'off');\n    field.setAttribute('spellcheck', 'false');\n  });\n});\n\nQualtrics.SurveyEngine.addOnload(function() {\n  var q = this;\n  var container = q.getQuestionContainer();\n  if (container && container.jquery) container = container[0];\n  var input = container ? container.querySelector('input[type=\"text\"], textarea, .InputText') : null;\n  if (!input) return;\n  var expected = 'I am able to commit to this';\n  var error = document.createElement('div');\n  error.className = 'ValidationError';\n  error.style.display = 'none';\n  error.style.marginTop = '8px';\n  error.textContent = 'Please type exactly: ' + expected;\n  input.parentNode.appendChild(error);\n  q.addOnPageSubmit(function() {\n    if ((input.value || '').trim() !== expected) {\n      error.style.display = 'block';\n      input.focus();\n      return false;\n    }\n    error.style.display = 'none';\n  });\n});"
      }
    },
