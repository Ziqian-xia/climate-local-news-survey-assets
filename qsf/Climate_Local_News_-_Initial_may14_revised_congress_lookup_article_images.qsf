      "Element": "SQ",
      "PrimaryAttribute": "QID3",
      "SecondaryAttribute": "survey_intro",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p>Thank you for participating in our survey! In this survey, we will ask you questions about the news.</p><p>This survey should take approximately 15 minutes to complete from start to finish, even taking your time and reading carefully.</p><p>During this survey, we ask that you please put your phone and any other distractions away and pay full attention.</p><p>Because your attention is so important to the quality of our survey results, we track time, activity, and tab switching. Please do not open other windows or navigate away from the survey.</p><p>In this survey, we are mostly interested in your own perceptions. Please answer each question to the best of your ability without using the internet or AI tools.</p>",
        "DataExportTag": "survey_intro",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "survey_intro",
